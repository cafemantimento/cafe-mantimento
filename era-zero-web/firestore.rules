rules_version = '2';
// Cada jogador só lê e escreve os próprios dados (users/{uid}/data/{documento}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'at'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.at is int;
    }
    // todo o resto é bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
